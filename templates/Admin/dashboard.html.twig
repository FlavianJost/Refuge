{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}Tableau de bord{% endblock %}

{% block main %}
    {% set animals_url = ea_url().setController('App\\Controller\\Admin\\AnimalCrudController').setAction('index') %}
    {% set requests_url = ea_url().setController('App\\Controller\\Admin\\AdoptionRequestCrudController').setAction('index') %}
    {% set users_url = ea_url().setController('App\\Controller\\Admin\\UserCrudController').setAction('index') %}
    {% set donations_url = ea_url().setController('App\\Controller\\Admin\\DonationCrudController').setAction('index') %}
    {% set reviews_url = ea_url().setController('App\\Controller\\Admin\\ReviewCrudController').setAction('index') %}
    {% set messages_url = path('app_message_manage_index') %}

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="text-uppercase text-muted small fw-bold">Animaux</div>
                    <div class="display-6 fw-bold mb-4">{{ animal_count }}</div>
                    <a class="btn btn-sm btn-primary mt-auto" href="{{ animals_url }}">Gérer les animaux</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="text-uppercase text-muted small fw-bold">Demandes d'adoption</div>
                    <div class="display-6 fw-bold mb-4">{{ request_count }}</div>
                    <a class="btn btn-sm btn-primary mt-auto" href="{{ requests_url }}">Voir les demandes</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="text-uppercase text-muted small fw-bold">Utilisateurs</div>
                    <div class="display-6 fw-bold mb-4">{{ user_count }}</div>
                    <a class="btn btn-sm btn-primary mt-auto" href="{{ users_url }}">Gérer les utilisateurs</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="text-uppercase text-muted small fw-bold">Dons</div>
                    <div class="display-6 fw-bold mb-4">{{ donation_count }}</div>
                    <a class="btn btn-sm btn-primary mt-auto" href="{{ donations_url }}">Voir les dons</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="text-uppercase text-muted small fw-bold">Total des dons confirmés</div>
                    <div class="display-6 fw-bold mb-4">{{ donation_total|number_format(2, ',', ' ') }} €</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="text-uppercase text-muted small fw-bold">Avis</div>
                    <div class="display-6 fw-bold mb-4">{{ review_count }}</div>
                    <a class="btn btn-sm btn-primary mt-auto" href="{{ reviews_url }}">Voir les avis</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="text-uppercase text-muted small fw-bold">Messagerie</div>
                    <div class="display-6 fw-bold mb-2">{{ conversation_count }}</div>
                    {% if conversation_unread > 0 %}
                        <span class="badge text-bg-warning mb-2 align-self-start">{{ conversation_unread }} non lu{{ conversation_unread > 1 ? 's' }}</span>
                    {% endif %}
                    <a class="btn btn-sm btn-primary mt-auto" href="{{ messages_url }}">Voir les conversations</a>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-light border mt-4 mb-0">
        Bienvenue dans l'espace d'administration du refuge. Utilisez le menu de gauche pour gérer les animaux,
        les demandes d'adoption, les dons, les avis, la messagerie et les utilisateurs.
    </div>
{% endblock %}
