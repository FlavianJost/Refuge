{% if events is empty %}
    <p class="text-muted mb-0">Aucun événement enregistré pour le moment.</p>
{% else %}
    <ol class="list-unstyled mb-0">
        {% for event in events %}
            <li class="d-flex gap-3 {{ not loop.last ? 'pb-3' }}">
                <div class="pt-1">
                    <span class="d-inline-block rounded-circle bg-{{ event.status.badgeClass() }}"
                          style="width: 12px; height: 12px;"></span>
                </div>
                <div>
                    <div class="fw-semibold">{{ event.title }}</div>
                    <div class="small text-muted">
                        {{ event.createdAt|date('d/m/Y à H:i') }}
                        {%- if event.author %} · {{ event.author.fullName }}{% endif %}
                    </div>
                    {% if event.note %}
                        <div class="mt-1">{{ event.note|nl2br }}</div>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ol>
{% endif %}
