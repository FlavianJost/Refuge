{% extends 'base.html.twig' %}

{% block title %}Modifier {{ animal.name }} - Refuge Animalier{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 mb-0">Modifier « {{ animal.name }} »</h1>
            <a href="{{ path('app_medical_manage_index', { id: animal.id }) }}" class="btn btn-outline-info">Dossier médical</a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                {% include 'Animal/form.html.twig' with { form: form, animal: animal } only %}
            </div>
        </div>
    </div>
{% endblock %}
