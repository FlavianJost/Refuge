{% extends 'base.html.twig' %}

{% block title %}Gestion des animaux - Refuge Animalier{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 mb-0">Gestion des animaux</h1>
            <a href="{{ path('app_animal_manage_new') }}" class="btn btn-primary">Ajouter un animal</a>
        </div>

        {% if animals is empty %}
            <div class="alert alert-info" role="alert">Aucun animal enregistré pour le moment.</div>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Photo</th>
                            <th>Nom</th>
                            <th>Espèce</th>
                            <th>Situation</th>
                            <th>Âge</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for animal in animals %}
                            <tr>
                                <td>
                                    {% if animal.photo %}
                                        <img src="/uploads/animals/{{ animal.photo }}" alt="{{ animal.name }}"
                                             width="56" height="56" class="rounded" style="object-fit: cover;">
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                    {% if animal.photos|length %}
                                        <div class="small text-muted mt-1">{{ animal.photos|length }} photo{{ animal.photos|length > 1 ? 's' }}</div>
                                    {% endif %}
                                </td>
                                <td>{{ animal.name }}</td>
                                <td>{{ animal.species.label() }}</td>
                                <td><span class="badge text-bg-{{ animal.status.badgeClass() }}">{{ animal.status.label() }}</span></td>
                                <td>{{ animal.age is not null ? animal.age : '—' }}</td>
                                <td class="text-end">
                                    <a href="{{ path('app_animal_show', { slug: animal.slug }) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                                    <a href="{{ path('app_animal_manage_edit', { id: animal.id }) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                                    <form method="post" action="{{ path('app_animal_manage_delete', { id: animal.id }) }}" class="d-inline"
                                          onsubmit="return confirm('Supprimer cet animal ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-animal-' ~ animal.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
