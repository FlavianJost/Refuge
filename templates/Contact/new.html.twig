{% extends 'base.html.twig' %}

{% block title %}Contacter le refuge{% endblock %}

{% block body %}
    <div class="container py-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_profile') }}">Mon profil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Contacter le refuge</li>
            </ol>
        </nav>

        <div class="row g-4">
            <div class="col-lg-7">
                <h1 class="h2 mb-4">Contacter le refuge</h1>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <p class="text-muted">
                            Envoyé en tant que <strong>{{ app.user.fullName }}</strong>
                            ({{ app.user.email }}).
                        </p>

                        {{ form_start(form) }}
                            {{ form_row(form.subject) }}
                            {{ form_row(form.message) }}

                            <div class="mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Envoyer mon message</button>
                                <a href="{{ path('app_profile') }}" class="btn btn-link">Annuler</a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <h2 class="h5 mb-3">Mes messages</h2>

                {% if messages is empty %}
                    <div class="alert alert-info mb-0">
                        Vous n'avez encore envoyé aucun message.
                    </div>
                {% else %}
                    <div class="list-group">
                        {% for contactMessage in messages %}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <strong>{{ contactMessage.subject }}</strong>
                                    <small class="text-muted">{{ contactMessage.createdAt|date('d/m/Y') }}</small>
                                </div>
                                <p class="mb-2 mt-1">{{ contactMessage.message }}</p>
                                {% if contactMessage.handled %}
                                    <span class="badge text-bg-success">Traité</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">En attente</span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
