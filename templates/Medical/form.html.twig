{{ form_start(form) }}
    <div class="row g-3">
        <div class="col-md-4">{{ form_row(form.date) }}</div>
        <div class="col-md-4">{{ form_row(form.category) }}</div>
        <div class="col-md-4">{{ form_row(form.veterinarian) }}</div>
        <div class="col-12">{{ form_row(form.title) }}</div>
        <div class="col-12">{{ form_row(form.description) }}</div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">{{ submit_label|default('Enregistrer') }}</button>
        {% if show_cancel|default(false) %}
            <a href="{{ path('app_medical_manage_index', { id: animal.id }) }}" class="btn btn-link">Annuler</a>
        {% endif %}
    </div>
{{ form_end(form) }}
