{% for message in messages %}
    {% set mine = message.isStaff == viewerIsStaff %}
    <div class="d-flex mb-2 {{ mine ? 'justify-content-end' : 'justify-content-start' }}">
        <div class="px-3 py-2 rounded-3 shadow-sm {{ mine ? 'bg-primary text-white' : 'bg-white border' }}" style="max-width: 80%;">
            <div class="small fw-semibold mb-1 {{ mine ? 'text-white-50' : 'text-muted' }}">
                {%- if mine -%}
                    Vous
                {%- elseif message.isStaff -%}
                    Le refuge
                {%- else -%}
                    {{ message.author ? message.author.fullName : 'Utilisateur' }}
                {%- endif -%}
            </div>
            <div style="white-space: pre-line;">{{ message.body }}</div>
            <div class="text-end small mt-1 {{ mine ? 'text-white-50' : 'text-muted' }}">
                {{ message.createdAt|date('d/m/Y H:i') }}
            </div>
        </div>
    </div>
{% endfor %}
