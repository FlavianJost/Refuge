{% extends 'base.html.twig' %}

{% block title %}Ma messagerie - Refuge Animalier{% endblock %}

{% block body %}
    <div class="container py-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_profile') }}">Mon profil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Ma messagerie</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="h2 mb-1">Ma messagerie</h1>
                <p class="text-muted">
                    Échangez directement avec l'équipe du refuge.
                    {% if refugeOnline %}
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                            <span class="d-inline-block rounded-circle bg-success me-1" style="width: 8px; height: 8px;"></span>Équipe en ligne
                        </span>
                    {% else %}
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">
                            <span class="d-inline-block rounded-circle bg-secondary me-1" style="width: 8px; height: 8px;"></span>Équipe hors ligne
                        </span>
                    {% endif %}
                </p>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div id="message-thread"
                             class="p-3 mb-3 rounded-3 bg-light overflow-auto"
                             style="max-height: 480px; min-height: 220px;"
                             data-controller="message-poll"
                             data-message-poll-url-value="{{ path('app_message_latest') }}"
                             data-message-poll-after-value="{{ messages is not empty ? messages|last.id : 0 }}">
                            <div data-message-poll-target="list">
                                {% include 'Message/messages.html.twig' with { messages: messages, viewerIsStaff: false } only %}
                            </div>
                        </div>

                        {% if messages is empty %}
                            <p class="text-muted small mb-3">
                                Envoyez votre premier message : l'équipe du refuge vous répondra ici.
                            </p>
                        {% endif %}

                        {{ form_start(form) }}
                            {{ form_row(form.body) }}
                            <div class="text-end mt-2">
                                <button type="submit" class="btn btn-primary">Envoyer</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
