{% extends 'base.html.twig' %}

{% block title %}Messagerie - Gestion - Refuge Animalier{% endblock %}

{% block body %}
    <div class="container py-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Messagerie</li>
            </ol>
        </nav>

        <h1 class="h2 mb-4">Messagerie</h1>

        {% if conversations is empty %}
            <div class="alert alert-info">Aucune conversation pour le moment.</div>
        {% else %}
            <div class="list-group shadow-sm">
                {% for conversation in conversations %}
                    <a href="{{ path('app_message_manage_show', { id: conversation.id }) }}"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold">
                                <span class="d-inline-block rounded-circle {{ conversation.user.isOnline ? 'bg-success' : 'bg-secondary' }} me-1"
                                      style="width: 8px; height: 8px;"
                                      title="{{ conversation.user.isOnline ? 'En ligne' : 'Hors ligne' }}"></span>
                                {{ conversation.user.fullName }}
                                {% if conversation.unreadForStaff > 0 %}
                                    <span class="badge bg-danger rounded-pill ms-1">{{ conversation.unreadForStaff }}</span>
                                {% endif %}
                            </div>
                            {% set last = conversation.lastMessage %}
                            {% if last %}
                                <div class="text-muted small text-truncate">
                                    {{ last.isStaff ? 'Vous : ' : '' }}{{ last.body|slice(0, 80) }}
                                </div>
                            {% endif %}
                        </div>
                        <div class="text-muted small text-nowrap">
                            {{ conversation.lastMessageAt|date('d/m/Y H:i') }}
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
