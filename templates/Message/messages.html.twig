{% for message in messages %}
    {% set mine = message.isStaff == viewerIsStaff %}
    {% set author = message.author %}
    <div class="d-flex align-items-end gap-2 mb-2 {{ mine ? 'justify-content-end' : 'justify-content-start' }}">
        {% if not mine %}
            <div class="flex-shrink-0 position-relative">
                {% if author and author.photo %}
                    <img src="/uploads/users/{{ author.photo }}" alt="{{ author.fullName }}"
                         class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;">
                {% else %}
                    <span class="rounded-circle bg-secondary bg-opacity-25 text-secondary fw-semibold d-inline-flex align-items-center justify-content-center"
                          style="width: 36px; height: 36px;">
                        {{ author ? author.initials : '?' }}
                    </span>
                {% endif %}
                {% if author %}
                    <span class="position-absolute bottom-0 end-0 rounded-circle border border-white {{ author.isOnline ? 'bg-success' : 'bg-secondary' }}"
                          style="width: 10px; height: 10px;"
                          title="{{ author.isOnline ? 'En ligne' : 'Hors ligne' }}"></span>
                {% endif %}
            </div>
        {% endif %}
        <div class="px-3 py-2 rounded-3 shadow-sm {{ mine ? 'bg-primary text-white' : 'bg-white border' }}" style="max-width: 80%;">
            <div class="small fw-semibold mb-1 {{ mine ? 'text-white-50' : 'text-muted' }}">
                {%- if mine -%}
                    Vous
                {%- elseif message.isStaff -%}
                    Le refuge
                {%- else -%}
                    {{ author ? author.fullName : 'Utilisateur' }}
                {%- endif -%}
            </div>
            <div style="white-space: pre-line;">{{ message.body }}</div>
            <div class="text-end small mt-1 {{ mine ? 'text-white-50' : 'text-muted' }}">
                {{ message.createdAt|date('d/m/Y H:i') }}
            </div>
        </div>
    </div>
{% endfor %}
