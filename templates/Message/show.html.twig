{% extends 'base.html.twig' %}

{% block title %}Conversation avec {{ conversation.user.fullName }} - Refuge Animalier{% endblock %}

{% block body %}
    <div class="container py-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_message_manage_index') }}">Messagerie</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ conversation.user.fullName }}</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="h2 mb-1">Conversation</h1>
                <p class="text-muted">
                    Avec <strong>{{ conversation.user.fullName }}</strong> ({{ conversation.user.email }})
                    {% if conversation.user.isOnline %}
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                            <span class="d-inline-block rounded-circle bg-success me-1" style="width: 8px; height: 8px;"></span>En ligne
                        </span>
                    {% else %}
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">
                            <span class="d-inline-block rounded-circle bg-secondary me-1" style="width: 8px; height: 8px;"></span>Hors ligne
                        </span>
                    {% endif %}
                </p>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div id="message-thread"
                             class="p-3 mb-3 rounded-3 bg-light overflow-auto"
                             style="max-height: 480px; min-height: 220px;"
                             data-controller="message-poll"
                             data-message-poll-url-value="{{ path('app_message_manage_latest', { id: conversation.id }) }}"
                             data-message-poll-after-value="{{ messages is not empty ? messages|last.id : 0 }}">
                            <div data-message-poll-target="list">
                                {% include 'Message/messages.html.twig' with { messages: messages, viewerIsStaff: true } only %}
                            </div>
                        </div>

                        {{ form_start(form) }}
                            {{ form_row(form.body) }}
                            <div class="text-end mt-2">
                                <button type="submit" class="btn btn-primary">Répondre</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
