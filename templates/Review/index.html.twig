{% extends 'base.html.twig' %}

{% block title %}Avis - Refuge Animalier{% endblock %}

{% block body %}
    <div class="container py-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('homepage') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Avis</li>
            </ol>
        </nav>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h2 mb-1">Avis sur le refuge</h1>
                {% if total > 0 %}
                    <p class="text-muted mb-0">
                        <span class="text-warning">{{ (average ?? 0)|number_format(1, ',', ' ') }} / 5</span>
                        <span class="ms-1">— {{ total }} avis</span>
                    </p>
                {% else %}
                    <p class="text-muted mb-0">Aucun avis pour le moment.</p>
                {% endif %}
            </div>
            {% if app.user %}
                <a href="{{ path('app_review_new') }}" class="btn btn-primary">Laisser un avis</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-primary">Connectez-vous pour laisser un avis</a>
            {% endif %}
        </div>

        {% if reviews is empty %}
            <div class="alert alert-light border">
                Soyez le premier à partager votre expérience !
            </div>
        {% else %}
            <div class="row g-4">
                {% for review in reviews %}
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-warning fs-5">{{ review.ratingStars }}</div>
                                        <div class="fw-semibold">{{ review.user ? review.user.fullName : 'Anonyme' }}</div>
                                    </div>
                                    <small class="text-muted">{{ review.createdAt|date('d/m/Y') }}</small>
                                </div>
                                <p class="mt-3 mb-0">{{ review.comment }}</p>

                                {% if app.user and (review.user == app.user or is_granted('ROLE_ADMIN')) %}
                                    <form method="post" action="{{ path('app_review_delete', { id: review.id }) }}"
                                          class="mt-3" onsubmit="return confirm('Supprimer cet avis ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-review-' ~ review.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
