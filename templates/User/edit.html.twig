{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="h2 mb-4">Modifier mon profil</h1>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        {{ form_start(form) }}
                            <div class="row g-3">
                                <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                                <div class="col-md-6">{{ form_row(form.lastName) }}</div>
                                <div class="col-12">{{ form_row(form.email) }}</div>
                                <div class="col-12">
                                    {% if user.photo %}
                                        <label class="form-label">Photo actuelle</label>
                                        <div class="mb-2">
                                            <img src="/uploads/users/{{ user.photo }}" alt="{{ user.fullName }}"
                                                 class="rounded-circle object-fit-cover" width="96" height="96">
                                        </div>
                                    {% endif %}
                                    {{ form_row(form.photoFile) }}
                                </div>
                            </div>

                            <hr class="my-4">

                            <h2 class="h5 mb-1">Changer de mot de passe</h2>
                            <p class="text-muted small mb-3">
                                Laissez ces champs vides pour conserver votre mot de passe actuel.
                            </p>
                            <div class="row g-3">
                                <div class="col-md-6">{{ form_row(form.currentPassword) }}</div>
                                <div class="col-md-6">{{ form_row(form.plainPassword) }}</div>
                            </div>

                            <div class="mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Enregistrer</button>
                                <a href="{{ path('app_profile') }}" class="btn btn-link">Annuler</a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
