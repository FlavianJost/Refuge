{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="mb-0">Mon profil</h1>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_contact') }}" class="btn btn-outline-primary">
                    Contacter le refuge
                </a>
                <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                    Modifier mon profil
                </a>
            </div>
        </div>

        {% set role_labels = {'ROLE_ADMIN': 'Administrateur', 'ROLE_VOLUNTEER': 'Bénévole', 'ROLE_USER': 'Utilisateur'} %}
        {% set initials = ((user.firstName|default(''))|slice(0, 1) ~ (user.lastName|default(''))|slice(0, 1))|upper %}
        {% if initials == '' %}
            {% set initials = user.email|slice(0, 1)|upper %}
        {% endif %}

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        {% if user.photo %}
                            <img src="/uploads/users/{{ user.photo }}" alt="{{ user.fullName }}"
                                 class="rounded-circle object-fit-cover mb-3" width="120" height="120">
                        {% else %}
                            <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center mx-auto mb-3"
                                 style="width: 120px; height: 120px; font-size: 2.5rem;">
                                {{ initials }}
                            </div>
                        {% endif %}

                        <h2 class="h4 mb-1">{{ user.fullName }}</h2>
                        <p class="text-muted mb-3">Membre depuis le {{ user.createdAt|date('d/m/Y') }}</p>

                        <ul class="list-group list-group-flush text-start">
                            <li class="list-group-item">
                                <strong>Email :</strong> {{ user.email }}
                            </li>
                            <li class="list-group-item">
                                <strong>Prénom :</strong> {{ user.firstName ?: '—' }}
                            </li>
                            <li class="list-group-item">
                                <strong>Nom :</strong> {{ user.lastName ?: '—' }}
                            </li>
                            <li class="list-group-item">
                                <strong>Rôles :</strong>
                                {% for role in user.roles %}
                                    <span class="badge text-bg-secondary">{{ role_labels[role] ?? role }}</span>
                                {% endfor %}
                            </li>
                            <li class="list-group-item">
                                <strong>Dernière connexion :</strong>
                                {{ user.lastLoginAt ? user.lastLoginAt|date('d/m/Y à H:i') : '—' }}
                            </li>
                            <li class="list-group-item">
                                <strong>Demandes d'adoption :</strong> {{ user.adoptionRequests|length }}
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <h2 class="h5 mb-3">Mes demandes d'adoption</h2>

                {% if user.adoptionRequests is empty %}
                    <div class="alert alert-info mb-0">
                        Vous n'avez encore aucune demande d'adoption.
                        <a href="{{ path('app_animal_index') }}" class="alert-link">Découvrir les animaux à adopter</a>.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Animal</th>
                                    <th>Statut</th>
                                    <th>Demandée le</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for request in user.adoptionRequests %}
                                    <tr>
                                        <td>{{ request.animal.name }}</td>
                                        <td>
                                            <span class="badge text-bg-{{ request.status.badgeClass }}">{{ request.status.label }}</span>
                                        </td>
                                        <td>{{ request.createdAt|date('d/m/Y') }}</td>
                                        <td>
                                            <a href="{{ path('app_animal_show', { slug: request.animal.slug }) }}">Voir l'animal</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="mt-4">
            <h2 class="h5 mb-3">Sécurité</h2>
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <strong>Authentification à deux facteurs (TOTP)</strong>
                            {% if user.totpAuthenticationEnabled %}
                                <span class="badge text-bg-success">Activée</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Désactivée</span>
                            {% endif %}
                        </div>
                        <p class="text-muted mb-0">
                            Protégez votre compte avec une application d'authentification (Google Authenticator, Authy...).
                        </p>
                    </div>
                    {% if user.totpAuthenticationEnabled %}
                        <form method="post" action="{{ path('app_profile_2fa_disable') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('totp-disable') }}">
                            <button type="submit" class="btn btn-outline-danger">Désactiver</button>
                        </form>
                    {% else %}
                        <a href="{{ path('app_profile_2fa_enable') }}" class="btn btn-primary">Activer</a>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="mt-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 class="h5 mb-0">Mes avis</h2>
                <a href="{{ path('app_review_new') }}" class="btn btn-sm btn-primary">Laisser un avis</a>
            </div>

            {% if user.reviews is empty %}
                <div class="alert alert-info mb-0">
                    Vous n'avez encore publié aucun avis.
                    <a href="{{ path('app_review_new') }}" class="alert-link">Partagez votre expérience</a>.
                </div>
            {% else %}
                <div class="row g-3">
                    {% for review in user.reviews %}
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="text-warning">{{ review.ratingStars }}</div>
                                        <small class="text-muted">{{ review.createdAt|date('d/m/Y') }}</small>
                                    </div>
                                    <p class="mt-2 mb-0">{{ review.comment }}</p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
