<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Refuge Animalier{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100 bg-light">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="{{ path('homepage') }}">Refuge</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Basculer la navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') == 'homepage' ? 'active' }}"
                               href="{{ path('homepage') }}">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_animal' ? 'active' }}"
                               href="{{ path('app_animal_index') }}">Les animaux</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_review' ? 'active' }}"
                               href="{{ path('app_review_index') }}">Avis</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_donation' ? 'active' }}"
                               href="{{ path('app_donation_new') }}">Faire un don</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        {% if app.user %}
                            {% if is_granted('ROLE_VOLUNTEER') %}
                                <li class="nav-item">
                                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_animal_manage' ? 'active' }}"
                                       href="{{ path('app_animal_manage_index') }}">Gestion</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_adoption_manage' ? 'active' }}"
                                       href="{{ path('app_adoption_manage_index') }}">Demandes</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_message_manage' ? 'active' }}"
                                       href="{{ path('app_message_manage_index') }}">Messagerie</a>
                                </li>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin' ? 'active' }}"
                                       href="{{ path('admin') }}">Administration</a>
                                </li>
                            {% endif %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    {{ app.user.fullName }}
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_profile') }}">Mon profil</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_message_index') }}">Ma messagerie</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="{{ path('_logout_main') }}">Se déconnecter</a>
                                    </li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-primary btn-sm" href="{{ path('app_register') }}">Inscription</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <main class="flex-grow-1">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="container mt-3">
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="bg-dark text-white-50 py-4 mt-auto">
            <div class="container text-center">
                <span>&copy; {{ 'now'|date('Y') }} Refuge Animalier</span>
            </div>
        </footer>
    </body>
</html>
